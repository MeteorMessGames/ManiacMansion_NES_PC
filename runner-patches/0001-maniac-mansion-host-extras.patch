+/* Fixed integer scale (cyc_host_display_set_scale). SDL's integer mode
+ * always picks the largest whole scale; for a smaller one, override the
+ * scale and the centered viewport SDL computed. Mouse events and
+ * SDL_RenderWindowToLogical use the renderer's current viewport and scale,
+ * so input mapping follows. SDL recomputes both on a window resize or a
+ * logical-size change, so this runs every frame before drawing. */
+static int s_fixed_scale;
+
+static void apply_fixed_scale(void)
+{
+    if (!s_ren || s_fixed_scale <= 0 || !SDL_RenderGetIntegerScale(s_ren)) return;
+    int ow = 0, oh = 0;
+    SDL_GetRendererOutputSize(s_ren, &ow, &oh);
+    int lw = s_tex_w, lh = logical_h();
+    if (lw <= 0 || lh <= 0) return;
+    int fit = ow / lw < oh / lh ? ow / lw : oh / lh;
+    int k = s_fixed_scale;
+    if (k >= fit) return;                          /* SDL's own fit is already k (or k doesn't fit) */
+    float sx = 0, sy = 0;
+    SDL_RenderGetScale(s_ren, &sx, &sy);
+    if (sx == (float)k && sy == (float)k) return;  /* ours is in place (SDL's own would be `fit`) */
+    SDL_Rect vp = { (ow - lw * k) / 2, (oh - lh * k) / 2, lw * k, lh * k };
+    SDL_RenderSetScale(s_ren, 1.0f, 1.0f);
+    SDL_RenderSetViewport(s_ren, &vp);
+    SDL_RenderSetScale(s_ren, (float)k, (float)k);
+}
+
+void cyc_host_display_set_scale(int scale)
+{
+    s_fixed_scale = scale > 0 ? scale : 0;
+    if (!s_ren) return;
+    SDL_RenderSetLogicalSize(s_ren, s_tex_w, logical_h());   /* back to SDL's own fit */
+    apply_picture_scale();
+    apply_fixed_scale();
+}
+
+int cyc_host_display_max_scale(void)
+{
+    if (!s_ren) return 1;
+    int ow = 0, oh = 0;
+    SDL_GetRendererOutputSize(s_ren, &ow, &oh);
+    int lw = cyc_video_width(), lh = 240 + (s_bar ? BAR_ROWS : 0);
+    int fit = ow / lw < oh / lh ? ow / lw : oh / lh;
+    return fit < 1 ? 1 : fit;
+}
+
 static void apply_settings(void)
 {
     if (!s_win) return;
     Uint32 fs = s_set.fullscreen == 1 ? SDL_WINDOW_FULLSCREEN_DESKTOP : s_set.fullscreen == 2 ? SDL_WINDOW_FULLSCREEN : 0;
     if ((SDL_GetWindowFlags(s_win) & (SDL_WINDOW_FULLSCREEN | SDL_WINDOW_FULLSCREEN_DESKTOP)) != fs)
         SDL_SetWindowFullscreen(s_win, fs);
-    if (!fs) SDL_SetWindowSize(s_win, s_tex_w * s_set.window_scale, logical_h() * s_set.window_scale);
+    /* Size from the game's own picture width (cyc_video), not the texture:
+     * a game may present a picture at the window's resolution (a CRT
+     * filter, a hi-res menu), and scaling that again would grow the window. */
+    if (!fs) SDL_SetWindowSize(s_win, cyc_video_width() * s_set.window_scale,
+                               (240 + (s_bar ? BAR_ROWS : 0)) * s_set.window_scale);
     SDL_RenderSetLogicalSize(s_ren, s_tex_w, logical_h());
     apply_picture_scale();
     if (s_tex) SDL_SetTextureScaleMode(s_tex, s_set.linear_filter ? SDL_ScaleModeLinear : SDL_ScaleModeNearest);
 }
 
+/* Host display controls for a game's own menu (cyc_host_extras.h). */
+void cyc_host_display_set(int fullscreen, int linear_filter, int integer_scale)
+{
+    if (fullscreen >= 0) s_set.fullscreen = fullscreen;
+    if (linear_filter >= 0) s_set.linear_filter = linear_filter ? 1 : 0;
+    if (integer_scale >= 0) s_set.integer_scale = integer_scale ? 1 : 0;
+    apply_settings();
+    save_settings();
+}
+void cyc_host_display_get(int *fullscreen, int *linear_filter, int *integer_scale)
+{
+    if (fullscreen) *fullscreen = s_set.fullscreen;
+    if (linear_filter) *linear_filter = s_set.linear_filter;
+    if (integer_scale) *integer_scale = s_set.integer_scale;
+}
+void cyc_host_display_refit(void)
+{
+    if (!s_win || (SDL_GetWindowFlags(s_win) & (SDL_WINDOW_FULLSCREEN | SDL_WINDOW_FULLSCREEN_DESKTOP))) return;
+    SDL_SetWindowSize(s_win, cyc_video_width() * s_set.window_scale,
+                      (240 + (s_bar ? BAR_ROWS : 0)) * s_set.window_scale);
+}
+void cyc_host_save_settings(void) { save_settings(); }
