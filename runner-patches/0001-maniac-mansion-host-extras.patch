diff --git a/runner/cyc/hw_apu.c b/runner/cyc/hw_apu.c
index a082d54..42488b9 100644
--- a/runner/cyc/hw_apu.c
+++ b/runner/cyc/hw_apu.c
@@ -21,6 +21,8 @@
 #include "cyc_core.h"
 #include "cyc_trace.h"
 #include "hw.h"
+#include "cyc_mod.h"
+#include "cpu6502.h"
 
 #include <math.h>
 #include <stdio.h>
@@ -140,6 +142,32 @@ static struct {
     uint8_t  level_dirty, level_dmc;
 } audio;
 
+/* Mod observation of APU register writes, and per-channel output gains
+ * (cyc_mod.h). Host policy, not machine state. */
+static CycModApuWriteHook s_apu_write_hook;
+void cyc_mod_set_apu_write_hook(CycModApuWriteHook hook) { s_apu_write_hook = hook; }
+static float s_ch_gain[5] = { 1, 1, 1, 1, 1 };
+static bool  s_ch_gain_on = false;
+void cyc_apu_set_channel_gain(int ch, float gain)
+{
+    if (ch < 0 || ch > 4) return;
+    if (gain < 0) gain = 0;
+    if (s_ch_gain[ch] == gain) return;
+    s_ch_gain[ch] = gain;
+    s_ch_gain_on = false;
+    for (int i = 0; i < 5; i++) if (s_ch_gain[i] != 1.0f) s_ch_gain_on = true;
+    audio.level_dirty = 1;
+}
+static double gained_level(const uint8_t out[5])
+{
+    double p = s_ch_gain[0] * out[0] + s_ch_gain[1] * out[1];
+    double t = 3.0 * s_ch_gain[2] * out[2] + 2.0 * s_ch_gain[3] * out[3] + s_ch_gain[4] * out[4];
+    double lp = p > 0 ? 95.52 / (8128.0 / p + 100) : 0;
+    double lt = t > 0 ? 163.67 / (24329.0 / t + 100) : 0;
+    return lp + lt;
+}
+
